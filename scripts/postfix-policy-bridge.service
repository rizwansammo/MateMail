[Unit]
Description=MateMail Postfix Policy Bridge
Documentation=https://github.com/your-org/matemail
After=network.target docker.service
Wants=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/matemail

# Load production environment variables from the project .env file
EnvironmentFile=/opt/matemail/.env

# Override listen address so mailcow Postfix can reach it from inside Docker
Environment=LISTEN_HOST=0.0.0.0
Environment=LISTEN_PORT=10031
Environment=DJANGO_INTERNAL_URL=http://127.0.0.1:8000
Environment=LOG_LEVEL=INFO

ExecStart=/usr/bin/python3 /opt/matemail/scripts/postfix_policy_bridge.py

# Restart on failure with a short delay
Restart=always
RestartSec=5
StartLimitInterval=60
StartLimitBurst=5

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target
