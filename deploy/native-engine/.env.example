# MateMail Native Engine — environment template (NE1).
#
# WHAT THIS CONFIGURES
#   Every value the Native Engine Compose project requires. Names only — this
#   file is committed, so it must never contain a real value.
#
# WHY IT IS SHAPED THIS WAY
#   Secrets are generated ON THE SERVER, never on a laptop and never in a
#   repository. The Compose file marks each of these `:?required`, so the stack
#   refuses to start rather than falling back to a default nobody chose.
#
#   Deliberately few secrets: one database password, one API secret, one policy
#   secret. Proliferating credentials makes rotation something people skip.
#
# WHICH PHASE OWNS IT
#   NE1.
#
# ON THE SERVER
#   install -m 0600 /dev/null /opt/MateMailNative/.env
#   python3 -c "import secrets; print(secrets.token_urlsafe(40))"

# ── Engine database ──────────────────────────────────────────────────────────
# Holds engine state only — domains, mailboxes, aliases, and mailbox password
# hashes from NE2 onward. It must NEVER hold users, sessions, tokens or billing;
# that is the control plane's database and a separate trust boundary (NE0.15).
NATIVE_DB_NAME=matemail_engine
NATIVE_DB_USER=engine
NATIVE_DB_PASSWORD=

# ── Native Engine API ────────────────────────────────────────────────────────
# Authenticates NativeMailEngineAdapter -> matemail-native-api. From NE5 this is
# the credential that lets MateMail provision at all.
NATIVE_API_SECRET=

# ── Policy bridge ────────────────────────────────────────────────────────────
# From NE5 these point at MateMail and must match its INTERNAL_API_SECRET, the
# same contract the live P5 bridge uses today.
#
# During NE1 the stack is ISOLATED: leave these at their Compose defaults so the
# bridge starts, stays healthy, and talks to nothing. It must not be pointed at
# production MateMail, and it must not replace the live P5 bridge.
NATIVE_POLICY_MATEMAIL_URL=
NATIVE_POLICY_SECRET=

# ── Images built under repository control ────────────────────────────────────
# Postfix, Unbound and Olefy have no acceptable upstream image (see README
# § Images), so they are built by GitHub Actions and published to GHCR. Pin each
# by tag AND digest once CI has published them; never `latest`, and never built
# on MateServer.
NATIVE_API_IMAGE=
NATIVE_DOVECOT_IMAGE=
NATIVE_POSTFIX_IMAGE=
NATIVE_UNBOUND_IMAGE=
NATIVE_OLEFY_IMAGE=
