# MateMail Native Engine — environment template (NE1).
#
# WHAT THIS CONFIGURES
#   Every value the Native Engine Compose project requires. Names only — this
#   file is committed, so it must never contain a real value.
#
# WHY IT IS SHAPED THIS WAY
#   Secrets are generated ON THE SERVER, never on a laptop and never in a
#   repository. The Compose file marks each of these `:?required`, so the stack
#   refuses to start rather than falling back to a default nobody chose.
#
#   Deliberately few secrets: one database password, one API secret, one policy
#   secret. Proliferating credentials makes rotation something people skip.
#
# WHICH PHASE OWNS IT
#   NE1.
#
# ON THE SERVER
#   install -m 0600 /dev/null /opt/MateMailNative/.env
#   python3 -c "import secrets; print(secrets.token_urlsafe(40))"

# ── Engine database ──────────────────────────────────────────────────────────
# Holds engine state only — domains, mailboxes, aliases, and mailbox password
# hashes from NE2 onward. It must NEVER hold users, sessions, tokens or billing;
# that is the control plane's database and a separate trust boundary (NE0.15).
NATIVE_DB_NAME=matemail_engine
NATIVE_DB_USER=engine
NATIVE_DB_PASSWORD=

# ── Native Engine API ────────────────────────────────────────────────────────
# Authenticates NativeMailEngineAdapter -> matemail-native-api. From NE5 this is
# the credential that lets MateMail provision at all.
NATIVE_API_SECRET=

# ── Policy bridge ────────────────────────────────────────────────────────────
# From NE5 these point at MateMail and must match its INTERNAL_API_SECRET, the
# same contract the live P5 bridge uses today.
#
# During NE1 the stack is ISOLATED: leave these at their Compose defaults so the
# bridge starts, stays healthy, and talks to nothing. It must not be pointed at
# production MateMail, and it must not replace the live P5 bridge.
NATIVE_POLICY_MATEMAIL_URL=
NATIVE_POLICY_SECRET=

# ── Images built under repository control ────────────────────────────────────
# Postfix, Unbound and Olefy have no acceptable upstream image (see README
# § Images), so they are built by GitHub Actions and published to GHCR. Pin each
# by tag AND digest once CI has published them; never `latest`, and never built
# on MateServer.
NATIVE_API_IMAGE=
NATIVE_DOVECOT_IMAGE=
NATIVE_POSTFIX_IMAGE=
NATIVE_UNBOUND_IMAGE=
NATIVE_OLEFY_IMAGE=

# ── NE3: mail-flow credentials ───────────────────────────────────────────────
#
# Postfix and Dovecot authenticate to the engine database as their own
# least-privilege roles (migration 003). Neither can write anything, and neither
# can read the other's views.
#
# These are set BY THE API at every start, from these values — the API is the
# only component permitted to write this database, so it is the only one that
# can configure the roles that may not. Rotating one is: change it here, restart.
#
# Generate with:  openssl rand -base64 33 | tr -d '=+/' | cut -c1-40
#
# The alphabet is constrained on purpose. Both entrypoints REFUSE to start if a
# password contains anything outside [A-Za-z0-9._~+=/:@-], because '#' opens a
# comment and a newline ends a setting in both config formats — an unlucky
# password would silently truncate the credential rather than fail loudly.
NATIVE_POSTFIX_DB_PASSWORD=
NATIVE_DOVECOT_DB_PASSWORD=

# Dovecot's credential for reporting a successful login to the engine API, which
# is what keeps `last_login_at` current without giving Dovecot write access.
#
# DELIBERATELY NOT the same value as NATIVE_API_SECRET. It opens exactly one
# endpoint. Sharing the provisioning secret would let the most network-exposed
# component in the engine create domains, mint mailboxes and rotate DKIM keys.
NATIVE_DOVECOT_POLICY_SECRET=

# ── NE4: operational control credentials ─────────────────────────────────────
#
# Generate independently, the same way as the NE3 credentials:
#   openssl rand -base64 33 | tr -d '=+/' | cut -c1-40
#
# Neither may reuse NATIVE_API_SECRET. They open narrower doors on purpose: a
# component that can list the queue should not also be able to provision a
# domain.

# The queue and quarantine control API, served by a daemon inside the Postfix
# container. Only the Native API calls it. Postfix REFUSES TO START without it,
# because the same daemon serves the submission rate-limit policy service and a
# missing policy service defers all submission.
NATIVE_CONTROL_SECRET=

# Dovecot's administrative HTTP API, used to measure real mailbox usage. Dovecot
# still starts without it; only usage reporting stops working.
NATIVE_DOVEADM_API_KEY=
