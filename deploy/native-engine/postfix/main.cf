# MateMail Native Engine — Postfix main.cf (NE1 foundation).
#
# WHAT THIS CONFIGURES
#   Enough Postfix to start, pass its own `postfix check`, and hold a queue.
#
# WHY IT IS SHAPED THIS WAY
#   NE1 proves the service foundation, not mail flow. The virtual domain,
#   mailbox, alias and sender-login maps that make this a working mail server
#   are NE3's, and adding them now would mean shipping lookups against a schema
#   NE2 has not designed yet.
#
#   What IS set here is everything that would be a security regression to add
#   late: no open relay, TLS required for submission, and DNSSEC/DANE for
#   outbound. Those defaults are easier to keep than to retrofit.
#
# WHICH PHASE OWNS IT
#   NE1 (skeleton). NE3 adds maps, milters and the policy hook.

compatibility_level = 3.6

myhostname = mx.matemail.online
mydomain = matemail.online
myorigin = $myhostname
inet_interfaces = all
# IPv4 ONLY, deliberately.
#
# The production mail engine does not use IPv6 today, and IPv6 sending is not a
# transport detail — it needs its own AAAA/PTR records and builds a SEPARATE
# sending reputation that receivers judge independently. Turning it on here
# would introduce that silently, in a foundation phase, with no DNS or PTR
# decision behind it.
#
# This constrains Postfix's transport and listening only. Unbound still resolves
# AAAA records normally; NE3+ may revisit IPv6 as an explicit decision.
inet_protocols = ipv4

# ── Logging ──────────────────────────────────────────────────────────────────
#
# Postfix logs to syslog by default, and this container has no syslog daemon.
# The result was silent: Postfix ran, delivered mail, and wrote NOTHING about
# it anywhere. `docker logs` showed only the control-plane wrapper's output.
#
# NE6 found this the hard way. The first message delivered through the Native
# path left no Postfix record at all — no queue id, no relay, no `status=sent`
# — so there was no way to prove where a message went, and P7's delivery,
# deferral, bounce and rejection counters had been reading an empty log and
# reporting a confident zero since the day they were written.
#
# `maillog_file` is Postfix 3.4+ native logging through the `postlogd` service
# already present in master.cf. /dev/stdout puts it where every other service
# in this stack puts it, under the same bounded json-file driver.
maillog_file = /dev/stdout

# One summary line per TLS session, inbound and outbound.
#
# At the default level 0 Postfix says nothing about TLS at all, so "was this
# message delivered over TLS, and was the peer certificate trusted" has no
# answer in the record — which is exactly the question asked after a delivery
# and the one NE7 will ask of every provider. Level 1 is a summary per
# connection, not a handshake trace: a few dozen bytes per message.
smtp_tls_loglevel = 1
smtpd_tls_loglevel = 1

# ── Anti-relay ───────────────────────────────────────────────────────────────
# mynetworks stays deliberately TIGHT. mailcow's includes its whole container
# subnet, which is why loopback SMTP tests there short-circuit at
# permit_mynetworks. Starting narrow means the policy hook NE3 installs is
# actually reached.
mynetworks_style = host
mynetworks = 127.0.0.0/8 [::1]/128

# NE3 inserts the MateMail policy hook here, after permit_mynetworks and
# BEFORE permit_sasl_authenticated — the ordering P5 proved in production.
# ── Virtual delivery: the engine database is the authority ───────────────────
#
# Every lookup goes through a VIEW owned by migration 003, never a base table.
# `engine_ro_postfix` cannot read a base table, cannot read password hashes, and
# cannot write anything — enforced by PostgreSQL grants, not by these queries
# being careful. The view definitions also carry the "active domain AND active
# mailbox" rule, so suspension has one meaning across submission, delivery and
# IMAP instead of three copies that eventually disagree.
#
# The map files are rendered at container start by images/postfix/entrypoint.sh
# because they carry the database password. The queries are in that script,
# where a diff shows them.
virtual_mailbox_domains = pgsql:/etc/postfix/sql/virtual_domain.cf
virtual_mailbox_maps    = pgsql:/etc/postfix/sql/virtual_mailbox.cf
virtual_alias_maps      = pgsql:/etc/postfix/sql/virtual_alias.cf

# Delivery is Dovecot's, over LMTP on the internal compose network. Postfix
# never writes to the mail store: one component owns Maildir, and it is the one
# that also serves IMAP, so there is no second writer to keep consistent.
# Delivered to a PINNED ADDRESS, not a name, and NE7 found out why the
# hard way.
#
# With `lmtp:inet:dovecot:24`, stopping the Dovecot container makes
# Docker's embedded DNS answer NXDOMAIN for `dovecot`. Postfix treats a
# host that does not exist as a PERMANENT failure and BOUNCES the mail:
#
#   status=bounced (Host or domain name not found. Name service error
#   for name=dovecot type=A: Host not found)  dsn=5.4.4
#
# So a routine Dovecot restart returned inbound customer mail to its
# senders instead of queueing it for the thirty seconds the restart took.
# Mail loss during a deploy, reported to the sender as a hard failure.
#
# An address cannot be NXDOMAIN. With the container down the connection is
# simply refused, which Postfix treats as temporary: the message waits in
# the queue and is delivered when Dovecot returns. The address is pinned in
# the compose file the same way Unbound's is, and for the same reason.
virtual_transport = lmtp:inet:172.27.0.24:24

# Postfix must not also try to deliver these locally.
local_recipient_maps =
mydestination = localhost.localdomain, localhost

# ── SMTP authentication ──────────────────────────────────────────────────────
#
# Delegated to Dovecot over a unix socket on a shared volume — not an inet
# listener — so a submission password never crosses the container network.
# Dovecot is already the authority on credentials; duplicating that into a
# Postfix-side password store would create a second copy to keep in sync.
smtpd_sasl_type = dovecot
smtpd_sasl_path = /run/dovecot-auth/auth-client
smtpd_sasl_auth_enable = no
smtpd_sasl_security_options = noanonymous
smtpd_sasl_local_domain = $myhostname

# ── Who may send as whom ─────────────────────────────────────────────────────
#
# THE anti-spoofing control. Without it any authenticated customer could put any
# address in MAIL FROM — including another tenant's — and Postfix would sign it
# with our DKIM key and send it over our IP reputation.
#
# The map returns every login allowed to use an envelope sender; the restriction
# rejects the mail when the authenticated login is not among them.
smtpd_sender_login_maps = pgsql:/etc/postfix/sql/sender_login.cf

# ── Restrictions ─────────────────────────────────────────────────────────────
#
# ORDER IS THE SECURITY PROPERTY, so each stage says what it is for.
#
# `permit_mynetworks` is FIRST and is safe only because mynetworks is host-local
# (127.0.0.0/8) — it is the container's own loopback, not the compose network.
# If it ever grew to include the Docker subnet, every container on that network
# would become an open relay.
# The last stage here is NE4's per-mailbox submission rate limit. It runs after
# ownership has been established, so the identity it charges is one the client
# has already proven it owns.
#
# NOTE: a comment may not sit inside this list. Postfix continues a logical line
# through every whitespace-indented line that follows, so an indented '#' would
# be parsed as a restriction name rather than a comment.
# The sender-login restrictions are NOT here. They live on the submission
# service in master.cf, and NE7 is why.
#
# Postfix ignores `reject_sender_login_mismatch` and its authenticated variant
# in any smtpd that does not have SASL enabled, and says so:
#
#   warning: restriction `reject_unauthenticated_sender_login_mismatch'
#            ignored: no SASL support
#
# Port 25 has SASL disabled by design — an MX that demands a password receives
# no mail — so listing them globally achieved exactly nothing on the public
# MX while printing two warning lines for every inbound connection. At any
# real volume that buries genuine warnings, and a configuration that states a
# protection it does not apply is worse than one that does not claim it.
#
# On inbound mail the defence against a forged sender is not this: it is SPF,
# DKIM and DMARC evaluation by Rspamd, which runs on every message. `-all` on
# the platform sender's SPF record is what makes a forgery fail there.
smtpd_sender_restrictions =
    reject_non_fqdn_sender,
    reject_unknown_sender_domain,
    check_policy_service inet:127.0.0.1:10032

# The rate-limit service lives inside this container on loopback, so it is not
# on the engine network at all. A failure to reach it DEFERS rather than
# permits: a limiter that fails open under load is not a limiter. (The service
# itself still fails open on a database or Redis error — see engine_control.py
# for why that specific case is different.)
smtpd_policy_service_default_action = 451 4.3.5 Server configuration problem
smtpd_policy_service_max_idle = 300s
smtpd_policy_service_max_ttl = 1000s
smtpd_policy_service_timeout = 10s

# ── Quarantine ───────────────────────────────────────────────────────────────
#
# Rspamd marks a message for quarantine by adding a header; this rule moves it
# to the HOLD queue, where it sits undelivered until something releases it.
#
# WHY THE HOLD QUEUE
#   It is the only Postfix state that means "accepted, retained, and going
#   nowhere until a human says so". Release is `postsuper -H`, which cannot
#   alter the sender, the recipients or the content — so releasing is
#   structurally incapable of redirecting someone's mail, which a re-injection
#   design would have to prevent by being careful.
#
# The header an external client might try to set is stripped by Rspamd before
# this rule sees it (milter_headers `remove`), so an Internet sender cannot
# reach this rule with a header of their own making.
# `milter_header_checks`, NOT `header_checks`.
#
# Ordinary header_checks inspect the message AS RECEIVED, before any milter has
# run, so they never see a header Rspamd added — the marker arrived in the
# delivered message and the rule had already been evaluated against a message
# that did not contain it. Measured: the message was delivered carrying
# `X-MateMail-Quarantine: yes`.
#
# `milter_header_checks` exists precisely for headers added by milters, and
# supports the same actions including HOLD.
milter_header_checks = regexp:/etc/postfix/header_checks

# Relay control. `reject_unauth_destination` is what stops this being an open
# relay: mail to a domain that is not ours is refused unless the client
# authenticated. It stays LAST so nothing after it can permit past it.
smtpd_relay_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_unauth_destination

smtpd_recipient_restrictions =
    reject_non_fqdn_recipient,
    reject_unknown_recipient_domain,
    check_policy_service inet:127.0.0.1:10032,
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_unauth_destination

# ── Content filtering ────────────────────────────────────────────────────────
#
# Rspamd as a milter: spam scoring, antivirus, and DKIM SIGNING all happen here.
# Signing in the milter rather than in Postfix is what keeps the private key out
# of Postfix entirely — Postfix cannot read the key store at all.
#
# `_action = tempfail` is deliberate. If Rspamd is unavailable the mail is
# deferred, not delivered unsigned and unscanned: a message that skipped the
# filter is worse than one that arrives a few minutes late.
smtpd_milters = inet:rspamd:11332
non_smtpd_milters = $smtpd_milters
milter_protocol = 6
milter_default_action = tempfail
milter_mail_macros = i {mail_addr} {client_addr} {client_name} {auth_authen}

# ── TLS ──────────────────────────────────────────────────────────────────────
smtpd_tls_cert_file = /etc/ssl/mail/cert.pem
smtpd_tls_key_file = /etc/ssl/mail/key.pem
smtpd_tls_security_level = may
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtpd_tls_protocols = >=TLSv1.2
smtpd_tls_auth_only = yes
tls_preempt_cipherlist = yes

# Outbound DANE. This is the reason the engine runs its own validating
# resolver (NE0.18) — without DNSSEC these two lines are decoration.
smtp_dns_support_level = dnssec
smtp_tls_security_level = dane
smtp_tls_protocols = >=TLSv1.2

# ── Limits and hygiene ───────────────────────────────────────────────────────
message_size_limit = 104857600
mailbox_size_limit = 0
smtpd_helo_required = yes
disable_vrfy_command = yes
smtpd_delay_reject = yes
biff = no
append_dot_mydomain = no
maximal_queue_lifetime = 5d
bounce_queue_lifetime = 1d

# Never advertise the software. Customers must not learn what runs underneath.
smtpd_banner = $myhostname ESMTP
