# MateMail backup configuration.
#
# Installed to /opt/MateMail/backup/backup.env as root:root 0600.
# This file names resources; it holds no passwords. The repository password
# lives in its own file so it never appears in a process listing or a log.

# ── Repository ───────────────────────────────────────────────────────────────
# NOTE: a repository on this same host protects against deletion, corruption
# and operator error. It does NOT protect against losing the host. It is
# retention, not disaster recovery. Set OFFSITE_REPOSITORY for that.
RESTIC_REPOSITORY=/opt/MateMail/backup/repo
RESTIC_PASSWORD_FILE=/opt/MateMail/backup/restic-password

# restic keeps a metadata cache under $HOME by default. systemd units have no
# HOME, so a timer run silently has no cache at all and prune degrades to a
# full repository walk every night. Naming it here gives both the timer and a
# hand run the same cache. It holds DECRYPTED index and tree metadata, so the
# directory is root-only.
RESTIC_CACHE_DIR=/var/cache/restic

# ── Offsite copy (no provider is assumed) ────────────────────────────────────
# Any repository restic understands: sftp:user@host:/path, s3:..., rest:...
# Left empty, the run still succeeds and records offsite=false in the manifest,
# and the log says plainly that this deployment has no disaster recovery.
OFFSITE_REPOSITORY=
OFFSITE_PASSWORD_FILE=

# ── Sources ──────────────────────────────────────────────────────────────────
MATEMAIL_DIR=/opt/MateMail/app
NATIVE_DIR=/opt/MateMail/engine/deploy/native-engine
MATEMAIL_DB_SERVICE=postgres
NATIVE_DB_SERVICE=db
VMAIL_VOLUME=matemail_native_vmail
DKIM_VOLUME=matemail_native_dkim

# Extra files needed to rebuild the deployment. Space separated.
CONFIG_FILES="/opt/MateMail/app/.env /opt/MateMail/app/docker-compose.yml /opt/MateMail/engine/deploy/native-engine/.env /opt/MateMail/engine/deploy/native-engine/docker-compose.yml /etc/nginx/conf.d/matemail-upstreams.conf /etc/nginx/sites-available/matemail-pro-autodiscover /etc/nginx/sites-available/matemail-pro-hub.conf /etc/nginx/sites-available/matemail-pro-phase-b /etc/nginx/sites-available/matemail-pro-phase-c-platform.conf /etc/nginx/sites-available/matemail-pro-phase-c-postbox.conf /etc/nginx/sites-available/matemail-pro-phase-c-web.conf /etc/letsencrypt/renewal-hooks/deploy/matemail-native-cert.sh /etc/systemd/system/matemail-backup.service /etc/systemd/system/matemail-backup.timer"

# Pinned helper image used to read a named volume without reaching into
# Docker's internal storage layout by hand.
HELPER_IMAGE=alpine:3.20

# ── Retention ────────────────────────────────────────────────────────────────
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=6
