      },
      "description": "Inodes sit beside bytes because Maildir stores one file per message and can exhaust inodes long before disk.",
      "gridPos": {
        "x": 16,
        "y": 26,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}) * 100",
          "legendFormat": "disk free %",
          "datasource": {
            "type": "prometheus",
            "uid": "matemail-prom"
          }
        },
        {
          "refId": "B",
          "expr": "(node_filesystem_files_free{mountpoint=\"/\"} / node_filesystem_files{mountpoint=\"/\"}) * 100",
          "legendFormat": "inodes free %",
