    {
      "id": 11,
      "type": "table",
      "title": "Native service health",
      "datasource": {
        "type": "prometheus",
        "uid": "matemail-prom"
      },
      "description": "Every Native service individually. 9 of 10 is not healthy, which is why there is no single average here.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "matemail_native_service_healthy",
          "datasource": {
            "type": "prometheus",
            "uid": "matemail-prom"
          },
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "instance": true,
              "__name__": true,
              "host": true,
              "service_name": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Native service availability",
      "datasource": {
        "type": "prometheus",
        "uid": "matemail-prom"
