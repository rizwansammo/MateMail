    {
      "id": 9,
      "type": "timeseries",
      "title": "Native queue by state",
      "datasource": {
        "type": "prometheus",
        "uid": "matemail-prom"
      },
      "description": "Deferred means temporary failure and retry. Held is quarantine and waits for a human. Opposite situations, so they are never summed into one number.",
