# MateMail monitoring runtime configuration.
#
# Installed to /opt/MateMail/monitoring/.env as root:root 0600.
# Never committed. The Grafana password is generated by install.sh and is
# never printed.

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Metrics retention. Capped by time AND size; the size cap is what actually
# protects the disk when new series appear.
PROM_RETENTION_TIME=15d
PROM_RETENTION_SIZE=2GB

# Where alerts are delivered off this host.
#
# Left empty on purpose: choosing a provider means choosing a third party and
# inventing credentials on the operator's behalf. Empty means alerts still
# fire and are visible in the Alertmanager UI over the SSH tunnel, but nothing
# leaves the box — reported as ALERT_RECEIVER_CONFIGURED=NO.
#
# It must NOT be an address served by Native Postfix, Mailcow, or MateMail's
# transactional sender: those are the things being monitored.
ALERT_WEBHOOK_URL=
