# MateMail — PRODUCTION environment template
#
# Copy to /opt/MateMail/.env on MateServer and fill in. Never commit the real file.
#   install -m 0600 /dev/null /opt/MateMail/.env
#
# Every value below is a placeholder. No real secret appears in this repository.
# Generate secrets on the server, not on a laptop and not in a chat window:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
#
# File permissions: 0600, owned by the user that runs docker compose. This file
# holds the database password, the Django signing key and the internal API
# secret; it is the most sensitive artifact on the host.

# ── Images (set by the deploy workflow) ───────────────────────────────────────
# SHA-pinned GHCR tags. The deploy workflow rewrites these two lines on each
# deployment. Never point them at :latest — a rollback must be able to name the
# exact image it is going back to.
MATEMAIL_BACKEND_IMAGE=ghcr.io/rizwansammo/matemail-backend:REPLACED_BY_DEPLOY
MATEMAIL_FRONTEND_IMAGE=ghcr.io/rizwansammo/matemail-frontend:REPLACED_BY_DEPLOY

# ── Django ───────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=generate-a-50-char-random-value-on-the-server
# `backend` is REQUIRED, not cosmetic: the Mail Engine's SMTP policy bridge
# reaches the app by its Compose service name across the private engine link, so
# `Host: backend:8000` must be accepted. Without it Django answers every policy
# question with 400 DisallowedHost, the bridge fails closed, and ALL mail defers.
# Measured during the P5 activation, not assumed.
# Every hostname Django will be reached on. A name missing here returns 400
# DisallowedHost before any view runs, which looks like an outage rather
# than a configuration error. `app.matemail.online` stays only because
# nginx's legacy redirect answers on it.
DJANGO_ALLOWED_HOSTS=hub.matemail.pro,portal.matemail.pro,postbox.matemail.pro,platform.matemail.pro,autodiscover.matemail.pro,matemail.pro,www.matemail.pro,portal.matemail.online,postbox.matemail.online,platform.matemail.online,autodiscover.matemail.online,app.matemail.online,matemail.online,backend,localhost,127.0.0.1

# ── Customer custom Hub/PostBox hostnames ────────────────────────────────────
# Phase 4 enables dynamic Host acceptance. The first middleware still accepts
# only fixed operator hosts or ACTIVE database-backed customer hostnames; READY
# certificate-only rows remain rejected until the edge worker activates routing.
CUSTOM_HOSTS_DYNAMIC_ENABLED=True
CUSTOM_HOST_CNAME_TARGET=custom.matemail.pro
CUSTOM_HOST_LEGACY_CNAME_TARGETS=custom.matemail.online
CUSTOM_HOST_RESERVED_SUFFIXES=matemail.online,matemail.pro
CUSTOM_HOST_CACHE_TTL=30

# ── Database (internal only — no host port is published) ─────────────────────
POSTGRES_DB=matemail
POSTGRES_USER=matemail
POSTGRES_PASSWORD=generate-a-strong-password-on-the-server

# ── Internal API secret ──────────────────────────────────────────────────────
# Shared with the Mail Engine policy bridge and the webmail front end. Guards
# every /api/internal/ endpoint, which host nginx also denies at the edge.
INTERNAL_API_SECRET=generate-a-40-char-random-value-on-the-server

# Separate credential for the Phase 3 root-owned nginx/Certbot provisioning
# worker. It can query/advance custom-host provisioning state and nothing else.
# Generate independently; never reuse INTERNAL_API_SECRET.
CUSTOM_HOST_PROVISIONER_SECRET=generate-a-separate-40-char-random-value-on-the-server

# ── Mail Engine ──────────────────────────────────────────────────────────────
# Production is Native-only. The Native API is private on matemail_engine_link.
MAIL_ENGINE_ADAPTER=native
NATIVE_ENGINE_API_URL=http://matemail-native-api:8451
NATIVE_ENGINE_API_SECRET=generate-a-strong-native-api-secret-on-the-server

# ── Mail platform identity
# Publish _spf.matemail.pro (TXT with sending IPs) and custom.matemail.pro (A)
# before switching the production .env to these new targets. ───────────────────────────────────────────────────
MAIL_DOMAIN=matemail.pro
# Cutover gate: do NOT apply this template until mail.matemail.pro SPF/DKIM/DMARC/MX
# are published and SMTP authentication is validated. Align PTR with Postfix
# myhostname=mx.matemail.pro; preserve the old sender until delivery tests pass.
MAIL_HOSTNAME=mx.matemail.pro
LEGACY_MAIL_HOSTNAME=mx.matemail.online
# The host a customer's SPF record includes to authorise our sending IPs.
# NOT the product domain: `_spf.matemail.pro` exists only to list those
# addresses, so it can change without touching a domain that serves a
# website (DEC-056). Customer SPF becomes:
#   v=spf1 include:_spf.matemail.pro ~all
SPF_INCLUDE_DOMAIN=_spf.matemail.pro
LEGACY_SPF_INCLUDE_DOMAIN=_spf.matemail.online
# Outlook mail-client discovery. Customers point an _autodiscover._tcp SRV
# record here; one central host, never a per-customer hostname, because a
# per-customer name would need a per-customer certificate (DEC-057).
AUTODISCOVER_HOST=autodiscover.matemail.pro
LEGACY_AUTODISCOVER_HOST=autodiscover.matemail.online
DKIM_SELECTOR=mm1

# INTERIM (DEC-007r) — encrypts the DKIM private keys Django still holds until
# P4 moves them into the Mail Engine. REQUIRED: `manage.py check --deploy`
# fails without it rather than storing signing keys in plaintext.
#
# Generate on the server, and keep it OUT of this file and out of Git:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# It must be different from DJANGO_SECRET_KEY. Rotation: put the new key first
# in a comma-separated list, redeploy, run `manage.py migrate domains`, then
# drop the old one.
DKIM_ENCRYPTION_KEY=generate-a-fernet-key-on-the-server

# ── Public URLs ──────────────────────────────────────────────────────────────
# MateMail Workspace — the customer surface. Renamed from
# app.matemail.online in P11; that name is now a redirect only.
FRONTEND_URL=https://hub.matemail.pro
APP_BASE_URL=https://hub.matemail.pro
# Platform Console (internal staff only, mandatory emailed 2FA).
PLATFORM_BASE_URL=https://platform.matemail.pro
# MateMail PostBox — the mailbox user's webmail.
POSTBOX_IMAP_HOST=mx.matemail.pro
POSTBOX_SIEVE_HOST=mx.matemail.pro
POSTBOX_SIEVE_PORT=4190
POSTBOX_SIEVE_STARTTLS=True
POSTBOX_SIEVE_TLS_SERVER_NAME=mx.matemail.pro
POSTBOX_MASTER_USER=postbox
# Must match NATIVE_POSTBOX_MASTER_PASSWORD in the Native Engine's .env.
# Alphabet is restricted to A-Za-z0-9._~+=/@- because Dovecot stores it in a
# colon-separated passwd record.
POSTBOX_MASTER_PASSWORD=change-me
CORS_ALLOWED_ORIGINS=https://hub.matemail.pro,https://portal.matemail.pro,https://postbox.matemail.pro,https://platform.matemail.pro,https://matemail.pro,https://portal.matemail.online,https://postbox.matemail.online,https://platform.matemail.online,https://matemail.online

# ── Native PostBox push (docs/POSTBOX_REMOTE_PUSH.md) ────────────────────────
# OPTIONAL, and mail delivery never depends on any of these. Left empty,
# devices can still register but no push is sent: without the ingest secret
# every engine report is refused; with it but no provider enabled, deliveries
# are recorded and nothing leaves.
# The Native Engine relay's credential. Must equal NATIVE_POSTBOX_PUSH_SECRET in
# the engine's .env, and must NOT be INTERNAL_API_SECRET. Generate on the server.
POSTBOX_PUSH_INGEST_SECRET=
# Android: FCM HTTP v1. The service-account JSON is a file mounted read-only
# into backend and celery-worker (never in Git, never in this file).
POSTBOX_FCM_ENABLED=False
POSTBOX_FCM_PROJECT_ID=
POSTBOX_FCM_CREDENTIALS_FILE=
# Windows: WNS via the Windows App SDK, a Microsoft Entra ID app registration.
POSTBOX_WNS_ENABLED=False
POSTBOX_WNS_TENANT_ID=
POSTBOX_WNS_CLIENT_ID=
POSTBOX_WNS_CLIENT_SECRET=

# NOTE: NEXT_PUBLIC_* are compiled into the frontend bundle at image build time.
# Changing them here has no effect on the browser bundle — the image must be
# rebuilt. They are listed so the server-side value matches the build.
NEXT_PUBLIC_API_URL=https://hub.matemail.pro
NEXT_PUBLIC_APP_URL=https://hub.matemail.pro
# The three hostnames middleware.ts routes by, and the retired one it redirects.
NEXT_PUBLIC_WORKSPACE_HOST=hub.matemail.pro
NEXT_PUBLIC_PLATFORM_HOST=platform.matemail.pro
NEXT_PUBLIC_POSTBOX_HOST=postbox.matemail.pro
NEXT_PUBLIC_LEGACY_WORKSPACE_HOSTS=app.matemail.online,portal.matemail.online,portal.matemail.pro

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Transactional email ──────────────────────────────────────────────────────
# Signup verification, password resets and team invites. If this is wrong,
# customers cannot verify an address or recover an account.
#
# Per DEC-013 MateMail sends this through its OWN Mail Engine, not a third-party
# provider. This block previously said the opposite — "do NOT point this at
# MateMail's own Mail Engine" — which was the pre-DEC-013 position and is no
# longer the architecture.
#
# The concern behind that older guidance has not gone away: a brand-new sending
# IP has no reputation, so verification mail can land in spam exactly when first
# impressions matter. It is addressed rather than avoided, by sending from a
# dedicated subdomain with its own SPF/DKIM (below) and by the PTR and warm-up
# work that gates customer mail.
#
# Submission host, not loopback. EMAIL_HOST has NO default, and an unset or
# loopback value is detected and logged as an error rather than silently
# discarding every message (apps/accounts/mailer.py). The canonical hostname is
# used deliberately: the engine presents a certificate for it on port 587
# STARTTLS, so TLS verifies normally. docker-compose.yml maps the name to the
# engine's private address for the containers that send.
EMAIL_HOST=mx.matemail.pro
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
# A dedicated service mailbox in the engine — NOT a customer mailbox and NOT an
# admin credential. It authenticates only to submit application mail, so that
# platform sending is separable from any tenant and can be revoked on its own.
# Rate limited at the engine to 60 messages/hour.
#
# Created in P4C-B. The value lives only on the server, in a root-only file;
# it is never committed. Leave these blank here and fill them in on the host.
EMAIL_HOST_USER=noreply@mail.matemail.pro
EMAIL_HOST_PASSWORD=

# A dedicated sending subdomain, so application mail has an authentication and
# reputation story independent of customer mail. Requires its own SPF/DKIM at
# the provider — see docs/DEPLOYMENT.md.
DEFAULT_FROM_EMAIL=MateMail <noreply@mail.matemail.pro>

# ── The platform sender (P5) ─────────────────────────────────────────────────
# MateMail's own service identity. It authenticates to the Mail Engine exactly
# like a customer does, so the SMTP policy bridge sees it on every verification
# email, password reset and invitation — and it has no mailbox row, no domain
# row and no tenant, because it is not a customer.
#
# Without this list the bridge rejects it as "Sender mailbox not found", which
# takes account recovery down for every customer the moment the policy service
# is enforced in the engine's submission restrictions.
#
# Comma-separated. A display name is tolerated, so this may be copied verbatim
# from DEFAULT_FROM_EMAIL above. Leave at the default unless the sending
# identity changes.
PLATFORM_SENDER_ADDRESSES=noreply@mail.matemail.pro

# The platform sender's own hourly ceiling. Deliberately finite: "we trust this
# identity" is not "this identity may send without limit", and the realistic
# failures are a leaked credential and a retry loop, both of which a ceiling
# contains.
#
# Matches the limit the Mail Engine already holds on the platform mailbox
# (measured, not assumed). Keep the two equal, and never set this ABOVE the
# engine's: a MateMail limit that never binds means a looping sender meets the
# engine's hard rejection instead of MateMail's retryable deferral.
PLATFORM_SENDER_MAX_PER_HOUR=60

# ── SMTP policy bridge (P5) ──────────────────────────────────────────────────
# INTERNAL_API_SECRET above is also what the Mail Engine's policy bridge uses to
# authenticate to MateMail. It must be set identically as
# MATEMAIL_INTERNAL_API_SECRET in the engine's mailcow.conf, or the bridge fails
# closed and every message defers. See deploy/engine/README.md.

# ── Abuse controls (P3b) ─────────────────────────────────────────────────────
# Trusted reverse-proxy hops. Host-native nginx is exactly one. Setting this
# higher than the real chain lets a caller forge the client IP that every
# per-IP rate limit is keyed on.
TRUSTED_PROXY_COUNT=1

# ── Refresh-token cookie (P3c) ───────────────────────────────────────────────
# The refresh token is an HttpOnly cookie rather than browser storage. Secure
# must stay True in production — it is the durable credential.
REFRESH_COOKIE_SECURE=True
REFRESH_COOKIE_SAMESITE=Strict
