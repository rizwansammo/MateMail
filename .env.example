# ─────────────────────────────────────────────────────────────────────────────
# MateMail environment variables
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django ────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-generate-a-real-secret-key

DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=app.matemail.online,webmail.matemail.online,matemail.online,localhost

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=matemail
POSTGRES_USER=matemail
POSTGRES_PASSWORD=change-me-strong-password

# Constructed from above — used by Django
DATABASE_URL=postgres://matemail:change-me-strong-password@postgres:5432/matemail

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Mail engine (mailcow) ─────────────────────────────────────────────────────
# Internal URL — never exposed publicly
# In production: mailcow containers must join the matemail_external Docker network
MAIL_ENGINE_API_URL=http://mailcow-nginx:8080

# Generate a strong API key in the mailcow admin panel, then paste here
MAIL_ENGINE_API_KEY=change-me-mailcow-api-key

# "stub" = no-op adapter (safe for local dev, no mailcow needed)
# "mailcow" = real mailcow REST API (production)
MAIL_ENGINE_ADAPTER=stub

# ── Internal API secret ───────────────────────────────────────────────────────
# Shared secret between Django and internal callers (Postfix policy daemon, webmail SSO)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(40))"
# nginx MUST block public access to /api/internal/ — only internal containers may call it
INTERNAL_API_SECRET=change-me-generate-a-real-secret

# ── Mail platform settings ────────────────────────────────────────────────────
MAIL_DOMAIN=matemail.online
MAIL_HOSTNAME=mx.matemail.online
DKIM_SELECTOR=mm1

IMAP_HOST=imap.matemail.online
SMTP_HOST=smtp.matemail.online
SMTP_SUBMISSION_PORT=587
IMAP_TLS_PORT=993
MAIL_STORAGE_PATH=/var/mail/vhosts

# ── Frontend URLs ─────────────────────────────────────────────────────────────
FRONTEND_URL=https://matemail.online
APP_BASE_URL=https://app.matemail.online
WEBMAIL_BASE_URL=https://webmail.matemail.online

NEXT_PUBLIC_API_URL=https://app.matemail.online
NEXT_PUBLIC_APP_URL=https://app.matemail.online

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://matemail.online,https://app.matemail.online,https://webmail.matemail.online

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Email (Django transactional — for password reset, verification, etc.) ─────
EMAIL_HOST=smtp.matemail.online
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@matemail.online
EMAIL_HOST_PASSWORD=change-me-noreply-mailbox-password
DEFAULT_FROM_EMAIL=MateMail <noreply@matemail.online>
