# ─────────────────────────────────────────────────────────────────────────────
# MateMail — LOCAL DEVELOPMENT environment
#
# Copy to .env and fill in. Used by docker-compose.yml (the dev stack).
#
# For PRODUCTION see deploy/env.production.example — the production template is
# separate on purpose, so a development default can never be mistaken for a
# production value.
#
# NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django ────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-generate-a-real-secret-key

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Customer custom-host development knobs. Keep dynamic Host acceptance off
# unless testing the custom-host routing path explicitly.
CUSTOM_HOSTS_DYNAMIC_ENABLED=False
CUSTOM_HOST_CNAME_TARGET=custom.matemail.online
CUSTOM_HOST_RESERVED_SUFFIXES=matemail.online
CUSTOM_HOST_PROVISIONER_SECRET=
CUSTOM_HOST_CACHE_TTL=30

# ── Database (dev container; production publishes no host port) ───────────────
POSTGRES_DB=matemail
POSTGRES_USER=matemail
POSTGRES_PASSWORD=matemail

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Mail Engine ───────────────────────────────────────────────────────────────
# Local development and CI use the stub by default. Native can be selected when
# a development Native Engine is attached to matemail_engine_link.
MAIL_ENGINE_ADAPTER=stub
NATIVE_ENGINE_API_URL=
NATIVE_ENGINE_API_SECRET=

# ── Internal API secret ───────────────────────────────────────────────────────
# Guards every /api/internal/ endpoint (SMTP policy, webmail token validation,
# operator health). Host nginx also denies that prefix at the edge in production.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(40))"
INTERNAL_API_SECRET=dev-only-internal-secret

# ── Native PostBox push (docs/POSTBOX_REMOTE_PUSH.md) ─────────────────────────
# Optional. Unset: devices can register, but no push is sent - without the
# ingest secret every engine report is refused; with it and no provider enabled,
# deliveries are recorded and nothing leaves.
# The ingest secret is the Native Engine relay's own - never INTERNAL_API_SECRET.
POSTBOX_PUSH_INGEST_SECRET=
POSTBOX_FCM_ENABLED=False
POSTBOX_FCM_PROJECT_ID=
POSTBOX_FCM_CREDENTIALS_FILE=
POSTBOX_WNS_ENABLED=False
POSTBOX_WNS_TENANT_ID=
POSTBOX_WNS_CLIENT_ID=
POSTBOX_WNS_CLIENT_SECRET=

# ── Mail platform identity ────────────────────────────────────────────────────
MAIL_DOMAIN=matemail.online
MAIL_HOSTNAME=mx.matemail.online
DKIM_SELECTOR=mm1

# ── URLs (dev ports match the MateServer allocation: 8020 / 3020) ────────────
# 8015 / 8016 / 3015 belong to MateConnect — do not use them for MateMail.
FRONTEND_URL=http://localhost:3020
APP_BASE_URL=http://localhost:3020
WEBMAIL_BASE_URL=http://localhost:3020
CORS_ALLOWED_ORIGINS=http://localhost:3020

# Compiled into the frontend bundle at image build time — a change needs a
# rebuild, not a restart.
NEXT_PUBLIC_API_URL=http://localhost:8020
NEXT_PUBLIC_APP_URL=http://localhost:3020

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Email ─────────────────────────────────────────────────────────────────────
# Dev settings use Django's console backend, so nothing is sent and no
# credentials are needed. Verification and reset links appear in the backend log.
#
# Production must use a dedicated transactional provider on a subdomain — never
# MateMail's own Mail Engine, which would make the platform depend on the thing
# it is bootstrapping. See deploy/env.production.example.
