# Force LF line endings on Linux/Mac, prevent CRLF conversion for scripts
* text=auto

# Shell scripts MUST use LF — CRLF will break execution on Linux
*.sh        text eol=lf
*.service   text eol=lf

# Python files — LF
*.py        text eol=lf

# Config files — LF
*.yml       text eol=lf
*.yaml      text eol=lf
*.conf      text eol=lf
*.cfg       text eol=lf
*.ini       text eol=lf
Dockerfile  text eol=lf
.env*       text eol=lf

# Web files
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.json      text eol=lf
*.css       text eol=lf
*.md        text eol=lf

# Binary files — no line ending conversion
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.pdf       binary
*.zip       binary
